          },
          "401": {
            "description": "Unauthorized or token expired"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Retrieve currently authenticated user profile and organizations",
        "tags": [
          "Authentication"
        ]
      }
    },
