                "$ref": "#/components/schemas/SupabaseSyncDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OAuth session synchronized and JWT token returned"
          }
        },
        "summary": "Synchronize Supabase OAuth session with MeetingOS database",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "AuthController_getMe",
        "parameters": [],
