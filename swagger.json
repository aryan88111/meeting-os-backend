  "info": {
    "title": "MeetingOS API",
    "description": "AI Meeting Intelligence & Organizational Knowledge Platform API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe",
            "description": "Full name of the user"
          },
          "email": {
            "type": "string",
            "example": "john@example.com",
            "description": "Email address"
          },
          "password": {
            "type": "string",
            "example": "SecureP@ssw0rd",
            "minLength": 8,
            "description": "Password (min 8 chars)"
          },
          "organizationName": {
            "type": "string",
            "example": "Acme Corp",
            "description": "Optional initial workspace name"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "john@example.com",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "example": "SecureP@ssw0rd",
            "description": "User password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SupabaseSyncDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsIn...",
            "description": "Supabase OAuth access token"
          },
          "email": {
            "type": "string",
            "example": "john@gmail.com",
            "description": "User email from OAuth profile"
          },
          "name": {
            "type": "string",
            "example": "John Doe",
            "description": "User full name from OAuth profile"
          },
          "avatarUrl": {
            "type": "string",
            "example": "https://lh3.googleusercontent.com/...",
            "description": "Avatar URL"
          },
          "providerToken": {
            "type": "string",
            "description": "Provider OAuth access token (e.g. Google Access Token)"
          },
          "providerRefreshToken": {
            "type": "string",
            "description": "Provider OAuth refresh token (e.g. Google Refresh Token)"
          },
          "provider": {
            "type": "string",
            "example": "google",
            "description": "OAuth provider name"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "GoogleAuthCallbackDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "OAuth 2.0 authorization code from Google consent redirect"
          },
          "redirectUri": {
            "type": "string",
            "description": "Redirect URI used in the initial OAuth request"
          }
        },
        "required": [
          "code"
        ]
      },
      "ParticipantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Sarah Chen",
            "description": "Participant full name"
          },
          "email": {
            "type": "string",
            "example": "sarah@example.com",
            "description": "Participant email address"
          },
          "role": {
            "type": "string",
            "example": "Lead Architect",
            "description": "Role or title"
          },
          "isExternal": {
            "type": "boolean",
            "example": false,
            "description": "Whether participant is external to organization"
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateMeetingDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Q3 Product Architecture & Sprint Kickoff",
            "description": "Meeting title"
          },
          "description": {
            "type": "string",
            "example": "Discuss core platform architecture, pgvector indexes, and sprint backlog."
          },
          "provider": {
            "type": "string",
            "enum": [
              "MANUAL",
              "GOOGLE_MEET",
              "MICROSOFT_TEAMS",
              "ZOOM"
            ],
            "default": "MANUAL"
          },
          "meetingUrl": {
            "type": "string",
            "example": "https://meet.google.com/abc-defg-hij",
            "description": "Direct meeting join URL"
          },
          "startTime": {
            "type": "string",
            "example": "2026-09-06T14:30:00.000Z",
            "description": "Scheduled start timestamp"
          },
          "endTime": {
            "type": "string",
            "example": "2026-09-06T15:30:00.000Z",
            "description": "Scheduled end timestamp"
          },
          "durationSeconds": {
            "type": "number",
            "example": 3600,
            "description": "Duration in seconds"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "WAITING_FOR_TRANSCRIPT",
              "TRANSCRIPT_RECEIVED",
              "QUEUED",
              "PROCESSING",
              "AI_COMPLETED",
              "DOCUMENT_GENERATING",
              "COMPLETED",
              "FAILED",
              "FAILED_PERMANENT"
            ],
            "default": "CREATED"
          },
          "participants": {
            "description": "List of meeting participants",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParticipantDto"
            }
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateMeetingDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Q3 Product Architecture & Sprint Kickoff",
            "description": "Meeting title"
          },
          "description": {
            "type": "string",
            "example": "Discuss core platform architecture, pgvector indexes, and sprint backlog."
          },
          "provider": {
            "type": "string",
            "enum": [
              "MANUAL",
              "GOOGLE_MEET",
              "MICROSOFT_TEAMS",
              "ZOOM"
            ],
            "default": "MANUAL"
          },
          "meetingUrl": {
            "type": "string",
            "example": "https://meet.google.com/abc-defg-hij",
            "description": "Direct meeting join URL"
          },
          "startTime": {
            "type": "string",
            "example": "2026-09-06T14:30:00.000Z",
            "description": "Scheduled start timestamp"
          },
          "endTime": {
            "type": "string",
            "example": "2026-09-06T15:30:00.000Z",
            "description": "Scheduled end timestamp"
          },
          "durationSeconds": {
            "type": "number",
            "example": 3600,
            "description": "Duration in seconds"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "WAITING_FOR_TRANSCRIPT",
              "TRANSCRIPT_RECEIVED",
              "QUEUED",
              "PROCESSING",
              "AI_COMPLETED",
              "DOCUMENT_GENERATING",
              "COMPLETED",
              "FAILED",
              "FAILED_PERMANENT"
            ],
            "default": "CREATED"
          },
          "participants": {
            "description": "List of meeting participants",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParticipantDto"
            }
          }
        }
      },
      "UploadTranscriptDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Raw transcript text or structured JSON string"
          },
          "filename": {
            "type": "string",
            "description": "Original filename (e.g. roadmap.txt, meeting.vtt)"
          },
          "mimeType": {
            "type": "string",
            "description": "MIME type of uploaded file"
          }
        },
        "required": [
          "content"
        ]
      },
      "UploadAndCreateMeetingDto": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Raw transcript text or structured JSON string"
          },
          "filename": {
            "type": "string",
            "description": "Original filename (e.g. roadmap.txt, meeting.vtt)"
          },
          "mimeType": {
            "type": "string",
            "description": "MIME type of uploaded file"
          },
          "title": {
            "type": "string",
            "description": "Title of the new meeting",
            "default": "Uploaded Meeting Transcript"
          },
          "description": {
            "type": "string",
            "description": "Meeting description"
          }
        },
        "required": [
          "content"
        ]
      },
      "AskKnowledgeBaseDto": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Natural language question to ask across workspace meeting intelligence",
            "example": "What did we decide in our last meeting?"
          },
          "sessionId": {
            "type": "string",
            "description": "Optional existing chat session ID to continue conversation"
          }
        },
        "required": [
          "query"
        ]
      },
      "RenameSessionDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "New session title",
            "example": "Sprint Architecture Q&A"
          }
        },
        "required": [
          "title"
        ]
      },
      "CreateApiKeyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name or label for the API Key",
            "example": "Production Webhook Service"
          },
          "scopes": {
            "description": "Array of permitted scopes",
            "example": [
              "meetings:read",
              "meetings:write",
              "rag:query"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expiresInDays": {
            "type": "number",
            "description": "Optional expiration in days (e.g., 30, 90, 365)",
            "example": 90
          }
        },
        "required": [
          "name"
        ]
      }
    }
  }
}